# Development Dockerfile for frontend with hot reload
FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies and wget for health check
RUN npm ci && apk add --no-cache wget

# Copy source code
COPY . .

# Build arguments for environment variables
ARG VITE_BACKEND_API_URL

# Set environment variables for development
ENV VITE_BACKEND_API_URL=$VITE_BACKEND_API_URL

# Expose Vite dev server port (matches vite.config.ts)
EXPOSE 8080

# Start Vite development server with host binding for Docker
CMD ["npm", "run", "dev"]